/* UBSI operator HMI — prototype v1.3 visual tokens */
QWidget {
    background-color: #08131d;
    color: #eaf4fb;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog { background-color: #08131d; }

QLabel { color: #eaf4fb; background: transparent; }
QLabel#muted, QLabel[role="muted"] { color: #8ea6b7; }
QLabel#pageTitle { color: #eaf4fb; font-size: 26px; font-weight: 700; }
QLabel#pageSubtitle { color: #8ea6b7; font-size: 13px; }
QLabel#sectionTitle { color: #eaf4fb; font-size: 12px; font-weight: 700; }

QFrame#panel,
QFrame#accentPanel,
QFrame[role="panel"] {
    background: #102333;
    border: 1px solid #264257;
    border-radius: 8px;
}
QFrame#accentPanel { border-color: #2e7de9; }

QPushButton {
    background: #132a3d;
    color: #eaf4fb;
    border: 1px solid #264257;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 600;
}
QPushButton:hover { background: #17334a; border-color: #58a5ff; }
QPushButton:pressed { background: #0e1e2c; }
QPushButton:checked,
QPushButton#primary {
    background: #2e7de9;
    border-color: #58a5ff;
    color: #ffffff;
}
QPushButton#primary:hover { background: #347fe4; }
QPushButton:disabled {
    background: #0e1e2c;
    border-color: #1a3346;
    color: #61788a;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #0e1e2c;
    color: #eaf4fb;
    border: 1px solid #264257;
    border-radius: 6px;
    padding: 7px 9px;
    selection-background-color: #2e7de9;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #58a5ff;
}
QComboBox::drop-down { border: 0; width: 22px; }
QComboBox QAbstractItemView {
    background: #102333;
    color: #eaf4fb;
    border: 1px solid #264257;
    selection-background-color: #17334a;
    outline: 0;
}

QTableWidget, QTreeWidget, QListWidget {
    background: #0e1e2c;
    alternate-background-color: #102333;
    color: #eaf4fb;
    border: 1px solid #1a3346;
    border-radius: 6px;
    gridline-color: #1a3346;
    outline: 0;
}
QTableWidget::item, QTreeWidget::item, QListWidget::item {
    padding: 7px 9px;
    border: 0;
}
QTableWidget::item:selected, QTreeWidget::item:selected, QListWidget::item:selected {
    background: #123b58;
    color: #eaf4fb;
}
QHeaderView::section {
    background: #0c1b28;
    color: #8ea6b7;
    padding: 7px 9px;
    border: 0;
    border-bottom: 1px solid #1a3346;
    font-size: 11px;
    font-weight: 600;
}
QTableCornerButton::section { background: #0c1b28; border: 0; }

QGroupBox {
    border: 1px solid #264257;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #8ea6b7;
}

QProgressBar {
    background: #0e1e2c;
    border: 1px solid #1a3346;
    border-radius: 4px;
    color: #eaf4fb;
    text-align: center;
}
QProgressBar::chunk { background: #2e7de9; border-radius: 3px; }

QCheckBox { color: #eaf4fb; spacing: 7px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    background: #0e1e2c;
    border: 1px solid #264257;
    border-radius: 4px;
}
QCheckBox::indicator:checked { background: #2e7de9; border-color: #58a5ff; }

QToolBar {
    background: #0c1b28;
    border-bottom: 1px solid #1a3346;
    spacing: 4px;
    padding: 3px;
}
QToolBar QToolButton {
    background: transparent;
    color: #8ea6b7;
    border: 0;
    border-radius: 6px;
    padding: 5px 8px;
}
QToolBar QToolButton:hover { background: #102333; color: #eaf4fb; }
QToolBar QToolButton:checked { background: #2e7de9; color: #fff; }
QToolBar::separator { background: #264257; width: 1px; margin: 4px; }

QDockWidget { color: #eaf4fb; font-weight: 600; }
QDockWidget::title { background: #0c1b28; padding: 7px 10px; border-bottom: 1px solid #264257; }

QMenuBar { background: #0c1b28; color: #8ea6b7; border-bottom: 1px solid #1a3346; }
QMenuBar::item { padding: 5px 10px; }
QMenuBar::item:selected { background: #102333; color: #eaf4fb; }
QMenu { background: #102333; color: #eaf4fb; border: 1px solid #264257; padding: 4px; }
QMenu::item { padding: 7px 18px; border-radius: 5px; }
QMenu::item:selected { background: #17334a; }
QMenu::separator { height: 1px; background: #264257; margin: 4px 0; }

QStatusBar { background: #0c1b28; color: #61788a; border-top: 1px solid #1a3346; }
QTextEdit, QPlainTextEdit {
    background: #071019;
    color: #8ea6b7;
    border: 1px solid #1a3346;
    border-radius: 5px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 10px;
}

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #264257; border-radius: 5px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #365a73; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #264257; border-radius: 5px; min-width: 24px; }
QScrollBar::handle:horizontal:hover { background: #365a73; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

QSplitter::handle { background: #1a3346; }
QSplitter::handle:hover { background: #2e7de9; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical { height: 3px; }

QToolTip {
    background: #132a3d;
    color: #eaf4fb;
    border: 1px solid #58a5ff;
    padding: 5px 8px;
    border-radius: 5px;
}
