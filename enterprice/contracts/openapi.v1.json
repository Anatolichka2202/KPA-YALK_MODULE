  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Heartbeat": {
        "properties": {
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "agent_version": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Agent Version"
          },
          "inventory": {
            "additionalProperties": true,
            "type": "object",
            "title": "Inventory"
          },
          "clock_status": {
            "type": "string",
            "enum": [
              "SYNCED",
              "UNSYNCED",
              "UNKNOWN"
            ],
            "title": "Clock Status",
            "default": "UNKNOWN"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "observed_at",
          "agent_version"
        ],
        "title": "Heartbeat"
      },
      "InterfaceSpec": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "enterprise",
              "ot",
              "service",
              "loopback"
            ],
            "title": "Role"
          },
          "alias": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Alias"
          },
          "vlan_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 4094.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Vlan Id"
          },
          "ipv4": {
            "type": "string",
            "format": "ipv4interface",
            "title": "Ipv4"
          },
          "gateway": {
            "anyOf": [
              {
                "type": "string",
                "format": "ipv4"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gateway"
          },
          "default_route": {
            "type": "boolean",
            "title": "Default Route",
            "default": false
          },
          "skip_as_source": {
            "type": "boolean",
            "title": "Skip As Source",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "alias",
          "ipv4"
        ],
        "title": "InterfaceSpec"
      },
      "Profile": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "station_code": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Station Code"
          },
          "interfaces": {
            "items": {
              "$ref": "#/components/schemas/InterfaceSpec"
            },
            "type": "array",
            "maxItems": 24,
            "minItems": 1,
            "title": "Interfaces"
          },
          "sockets": {
            "items": {
              "$ref": "#/components/schemas/SocketSpec"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Sockets"
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/ResourceSpec"
            },
            "type": "array",
            "maxItems": 250,
            "title": "Resources"
          },
          "required_capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Required Capabilities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "station_code",
          "interfaces"
        ],
        "title": "Profile"
      },
      "ResourceSpec": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "rs485",
              "serial",
              "usb",
              "visa",
              "can",
              "ethernet",
              "gpio",
              "other"
            ],
            "title": "Kind"
          },
          "owner": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Owner"
          },
          "exclusive": {
            "type": "boolean",
            "title": "Exclusive",
            "default": true
          }
        },
