{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miltech.invalid/contracts/release-spec.v1.schema.json",
  "title": "MilTech Station release build specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_id", "version", "target_platform", "publisher_key_id", "components"],
  "properties": {
    "release_id": {"type": "string", "format": "uuid"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?$"},
    "target_platform": {"enum": ["windows-x64", "windows-arm64", "linux-x64"]},
    "publisher_key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,100}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "required_capabilities": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}},
    "components": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "version", "paths"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,100}$"},
          "kind": {"enum": ["core", "plugin", "tu", "scenario", "catalog", "profile", "runtime"]},
          "version": {"type": "string"},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
