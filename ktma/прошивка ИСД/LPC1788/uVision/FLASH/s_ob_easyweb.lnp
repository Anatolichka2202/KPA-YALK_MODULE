--cpu Cortex-M3
".\flash\system_lpc177x_8x.o"
".\flash\ethmac.o"
".\flash\startup_lpc177x_8x.o"
".\flash\easyweb.o"
".\flash\ew_systick.o"
".\flash\tcpip.o"
".\flash\serial.o"
--strict --scatter ".\FLASH\s_ob_easyweb.sct"
